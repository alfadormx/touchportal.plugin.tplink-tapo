{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Generate entry.tp",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\tppsdk.exe",
      "args": [
        "plugin/TPLinkTapoPlugin.py"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "Package plugin",
      "type": "shell",
      "command": "${workspaceFolder}\\.venv\\Scripts\\tppbuild.exe",
      "args": [
        "plugin/build.py"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}